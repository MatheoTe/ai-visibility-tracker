{
  // Full system in the browser: Postgres, Redis, API, workers, scheduler and the
  // dashboard from ../docker-compose.yml, on the fake LLM provider with the seeded
  // demo workspace. No secrets needed. Sign in with demo@avt.dev / demo-password.
  "name": "AI Visibility Tracker",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12", "installTools": false }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "Dashboard", "onAutoForward": "openBrowser" },
    "8000": { "label": "API (docs at /docs)", "onAutoForward": "notify" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },
  // Builds the images once; every start brings the stack up (idempotent, cached).
  "postCreateCommand": "docker compose -f docker-compose.yml -f .devcontainer/docker-compose.codespaces.yml build",
  "postStartCommand": "docker compose -f docker-compose.yml -f .devcontainer/docker-compose.codespaces.yml up -d",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
