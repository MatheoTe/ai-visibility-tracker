# Copy to .env. Every variable is optional: with no provider keys the system runs
# end to end on the deterministic fake provider.

# --- Provider keys (any subset) ---
# AVT_ANTHROPIC_API_KEY=
# AVT_OPENAI_API_KEY=
# AVT_GEMINI_API_KEY=
# AVT_PERPLEXITY_API_KEY=

# Models (defaults shown). Workspaces store "provider:model" keys.
# AVT_ANTHROPIC_ANSWER_MODEL=claude-sonnet-5-5
# AVT_ANTHROPIC_ANALYSIS_MODEL=claude-haiku-4-5-20251001
# AVT_OPENAI_MODEL=gpt-5-mini
# AVT_GEMINI_MODEL=gemini-2.5-flash
# AVT_PERPLEXITY_MODEL=sonar
# AVT_ENABLE_WEB_SEARCH=false        # let Claude/GPT/Gemini search the web (answers with citations)
# AVT_FORCE_FAKE_PROVIDERS=false     # ignore keys and use the fake provider everywhere

# --- Per-provider throughput limits (shared by all workers) ---
# AVT_LIMITS_ANTHROPIC_REQUESTS_PER_MINUTE=600
# AVT_LIMITS_ANTHROPIC_TOKENS_PER_MINUTE=400000
# AVT_LIMITS_ANTHROPIC_MAX_CONCURRENCY=32
# (same for OPENAI, GEMINI, PERPLEXITY)

# --- Execution policy ---
# AVT_MAX_TASK_ATTEMPTS=5
# AVT_RETRY_BUDGET_RATIO=0.25
# AVT_BREAKER_FAILURE_RATIO=0.5
# AVT_BREAKER_MIN_REQUESTS=20
# AVT_BREAKER_COOLDOWN_SECONDS=20

# --- Security (change in any shared deployment) ---
# AVT_JWT_SECRET=change-me-to-a-long-random-string
